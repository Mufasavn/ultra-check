{
  "manifest_version": 3,
  "name": "Ultra Check Bridge",
  "version": "1.3.1",
  "description": "Lets the local Ultra Check app read public Google Ads Transparency data through your own browser tab.",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://adstransparency.google.com/*",
    "https://displayads-formats.googleusercontent.com/*",
    "https://tpc.googlesyndication.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://adstransparency.google.com/*"
      ],
      "js": [
        "xsrf-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
